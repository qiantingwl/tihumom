{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "allowJs": true
  },
  "include": ["vite.config.ts", "server/**/*.ts", "tests/**/*.ts", "server/**/*.js"]
}
