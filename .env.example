HOST=127.0.0.1
PORT=8988
# Run npm run setup (or the Docker setup command in docs/DEPLOYMENT.md).
# Never expose this file or reuse the placeholder as a real admin token.
ADMIN_TOKEN=replace-with-a-random-secret
COOKIE_SECURE=false
# Build-time public URL for sharing, QR codes and API examples.
VITE_PUBLIC_ORIGIN=https://www.tihu.mom
# Enable only behind a trusted reverse proxy on the same host:
# TRUST_PROXY=loopback
# DATA_DIR=./data
# LOG_LEVEL=info
